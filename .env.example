# Application
PORT=3000
NODE_ENV=development

# Database configuration
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=123456
DB_NAME=realworld_nest

# JWT Secret
JWT_SECRET=super_secret_jwt_key_medium_clone_realworld
JWT_EXPIRES_IN=7d

# Cloudinary Storage (optional - fallbacks to local disk storage when omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mail / SMTP Configuration (optional - fallbacks to console logger when omitted)
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@realworld.local
